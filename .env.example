# Copy to .env — never commit real values.
#
# Only the first block is required. Everything else has a working default, and
# the reconstruction core (`python -m timesheet.demo`) needs none of it at all.

# --- required for the web service ------------------------------------------

# Signs sessions and encrypts stored Microsoft/GitHub tokens. With no key set,
# nobody can sign in and no credential can be stored — deliberately, because a
# default key is a public key. Generate one:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where this service is reachable. The OAuth callback is <PUBLIC_URL>/auth/callback,
# and links in delivered messages point here.
PUBLIC_URL=http://localhost:8000

# A GitHub OAuth App: Settings -> Developer settings -> OAuth Apps.
#   Homepage URL              <PUBLIC_URL>
#   Authorization callback    <PUBLIC_URL>/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Which GitHub. Register the OAuth app on this same host.
#   github.com             public GitHub          -> api.github.com
#   acme.ghe.com           Enterprise Cloud with data residency
#                          (GitHub-operated)      -> api.acme.ghe.com
#   github.acme.internal   Enterprise Server      -> .../api/v3
# A .ghe.com tenant looks like a private hostname but is not one, and has no
# /api/v3 on it — treating it as an Enterprise Server returns nothing at all.
GITHUB_HOST=github.com
# The `repo` scope is what lets the commit search see private repositories. Drop
# it if you only care about public work.
GITHUB_OAUTH_SCOPES=read:user user:email repo read:org

# --- who may hold an account -----------------------------------------------

# single (default) | allowlist | org | open.
# `single` means the first account to sign in claims this deployment and every
# later one is refused. That is the default on purpose: this stores delegated
# mailbox tokens, so a fresh deployment must not be an open door.
ACCESS_POLICY=single
ALLOWED_LOGINS=                       # for allowlist: comma-separated GitHub logins
ALLOWED_ORGS=                         # for org: comma-separated org logins

# --- storage ----------------------------------------------------------------

# PostgreSQL when set; a directory of JSON files otherwise (local dev only —
# FileStore has no locking, so two writers can lose an update).
DATABASE_URL=
DATA_DIR=./data

# --- Microsoft 365 ----------------------------------------------------------
#
# Normally nothing here needs setting: each person connects their own account
# from the Connections page with a device code, which needs no Azure app
# registration and no admin consent.

# Entra authority. 'organizations' resolves each signer's own home tenant; pin a
# tenant id only if sign-in lands in the wrong directory (a UPN can look
# identical in two, and the wrong one gives convincing wrong answers).
M365_MCP_TENANT=organizations
# Folder names to read, if your mailbox uses different ones.
M365_MCP_SENT_FOLDER=Sent Items
M365_MCP_INBOX_FOLDER=Inbox

# Alternative calendar sources, for tenants that block the above. Both give
# meetings only — no mail, no chat. There is NO fallback between sources on
# failure: a silent swap would make a broken connector look like a week with no
# meetings, which reconstructs into a plausible, wrong, all-admin sheet.
#
# A published Outlook calendar (OWA -> Settings -> Calendar -> Shared calendars).
# Note that this URL is a world-readable secret, and 'availability only' detail
# hides every subject behind a bare "Busy".
M365_ICS_URL=
# Device-code Microsoft Graph. Needs `pip install ".[graph]"`, and many tenants
# block it outright (AADSTS65002 / 700016).
M365_CLIENT_ID=
M365_TENANT=
M365_TOKEN_CACHE=/var/lib/timesheet/m365.token.json

# --- single-user / CLI ------------------------------------------------------
#
# For `python -m timesheet.collectors.github` and a single-user install with no
# web sign-in. The service reads each account's own credentials instead.
GITHUB_USER=
GITHUB_TOKEN=
# Where `python -m timesheet.collectors.mcp_client login` writes its token. That
# file is a credential: a refresh token is standing read access to the mailbox
# that never re-prompts for MFA. Must be writable — Entra rotates the refresh
# token on every use, so a read-only path replays a spent one until it dies.
M365_MCP_TOKEN_CACHE=/tmp/m365-mcp-token.json
M365_MCP_TOKEN_JSON=

# --- reconstruction defaults ------------------------------------------------
#
# Each account overrides these for itself under Settings. These are only the
# starting values a new account gets.

LOCALE=en                             # en | nl
TZ=UTC
DAY_START=08:30                       # opens earlier if the day's activity shows it
EARLIEST_START_FLOOR=06:00
DAY_ROLLOVER_HOUR=5                   # work before this hour counts as the previous day
MIN_DAY_MINUTES=480                   # a busy day is allowed to run longer
ROTA_ENABLED=false                    # a fixed morning on-call slot
ROTA_MINUTES=75
INCLUDE_REVIEWS=true
INCLUDE_AUTHORED=true
INCLUDE_EMAIL=true
INCLUDE_CHAT=true
BACKFILL_WEEKS=6                      # how far back the scheduled run fills in

# How long the scheduled refresh's copy of the CURRENT week is served before a
# page view rebuilds it live. Set it to about your refresh interval: it is the
# staleness bound on "this week".
LIVE_MAX_AGE_SECONDS=900

# --- delivery ---------------------------------------------------------------
#
# Mail belongs to the deployment, not to an account holder: a user supplies a
# recipient, never a mail server's credentials, so nobody can turn this into an
# open relay from a settings form. Mail is sent from REPORT_EMAIL_FROM with the
# account holder's address as Reply-To.
#
# Set EITHER the SMTP block or the Mailgun one. Mailgun's API wins if both are
# set, because configuring it is a deliberate move away from SMTP — it exists for
# hosts that block outbound 25/465/587, where no SMTP setting can be made to work.
REPORT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=

# Mailgun over HTTPS. An EU domain answers on https://api.eu.mailgun.net and
# nowhere else: a key for the wrong region fails exactly like a wrong key.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net

# Delivering over Teams needs ChatMessage.Send, which the shared Microsoft
# connector's app registration does not carry. Leave this off unless your tenant
# grants it — otherwise it is an option that fails at the moment somebody uses it.
DELIVERY_CHAT_ENABLED=false

DOWNLOAD_TTL_SECONDS=604800           # a signed .xlsx link is valid 7 days

# --- optional AI label polish ------------------------------------------------
#
# Any OpenAI-compatible endpoint. An empty model means AI is off and the
# deterministic summariser is used. Applied only in the scheduled refresh, never
# in a web request: a model can take 10-20s a call.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=low
