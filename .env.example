# Copy to .env — never commit real values.

# --- GitHub Enterprise (commits/PRs/issues) ---
GHE_HOST=pinkroccade.ghe.com
GHE_ORG=samenlevingszaken
GHE_USER=sargea50
GHE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Microsoft 365 calendar ---
# Which collector runs: mcp | ics | graph. Unset keeps the historical behaviour
# (ics if M365_ICS_URL is set, else graph). There is no fallback on failure: a
# silent swap would make a broken source look like a week with no meetings, and
# that reconstructs into a plausible, wrong, all-admin sheet.
M365_SOURCE=mcp

# mcp — Claude's Microsoft 365 MCP connector. The tenant blocks device-code Graph
# but has already consented to the app pair this borrows, so it needs no app
# registration and no admin. Gives real subjects (a published ICS set to
# "availability only" hides them all behind "Busy"), no rolling three-month
# window, and email + Teams activity, which is what /api/ingest was built for.
#   python -m timesheet.collectors.mcp_client login     # once, interactive
# Then put the contents of the cache file here. It holds a refresh token, i.e.
# standing read access to the mailbox that never re-prompts for MFA.
M365_MCP_TOKEN_JSON=
# Where that JSON is written. Must be writable: Entra rotates the refresh token
# on every use, so a read-only path silently replays a spent one until it dies.
M365_MCP_TOKEN_CACHE=/tmp/m365-mcp-token.json
# Entra authority. 'organizations' resolves your home tenant; pin the tenant id
# only if sign-in lands in the wrong directory (the UPN looks identical in both).
M365_MCP_TENANT=organizations
# Teams messages are filtered to your own; defaults to get_me()'s display name.
M365_MCP_TEAMS_SENDER=

# ics — publish your Outlook calendar and paste the secret .ics URL here.
M365_ICS_URL=

# graph — device-code against a Microsoft first-party client. Blocked in this
# tenant (AADSTS65002 / 700016); kept for tenants where it still works.
M365_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dad67c   # Microsoft Graph PowerShell (first-party)
M365_SCOPES=Calendars.Read offline_access
M365_TOKEN_CACHE=/var/lib/github-timesheet/m365.token.json

# --- Reconstruction ---
TZ=Europe/Amsterdam
DAY_START=07:30
TARGET_MINUTES=480
ROTA_ENABLED=true
ROTA_MINUTES=75
INCLUDE_AFTER_HOURS=false

# --- Optional AI label polish (DeepSeek via a LiteLLM proxy) ---
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=deepseek-chat

# --- Delivery ---
PUBLIC_URL=https://uren.calebsargeant.com
DOWNLOAD_TTL_SECONDS=604800          # signed .xlsx link valid 7 days
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=caleb@calebsargeant.com
REPORT_EMAIL_TO=marc.vergunst@pinkroccade.nl

# --- Shared firefly CNPG ---
DATABASE_URL=postgresql://github_timesheet:xxxx@cnpg-rw.firefly.svc:5432/github_timesheet
